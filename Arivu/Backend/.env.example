# Arivu Backend Configuration
# Copy this file to .env and fill in your values

# ── Server Configuration ──────────────────────────────────────────
# Host address to bind the backend server (127.0.0.1 = localhost only, 0.0.0.0 = all interfaces)
ARIVU_BACKEND_HOST=127.0.0.1
# Port number for the backend server
ARIVU_BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (use * to allow all, not recommended for production)
ARIVU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── OpenAI Configuration ──────────────────────────────────────
# Required if using OpenAI models (GPT-4, text-embedding-3-small, etc.)
ARIVU_OPENAI_API_KEY=

# ── Embedding Backend ─────────────────────────────────────────
# Options: "local" (HuggingFace) or "openai"
ARIVU_EMBEDDING_BACKEND=local

# Model names for each backend
ARIVU_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
ARIVU_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM Backend ───────────────────────────────────────────────
# Options: "ollama" (local) or "openai"
ARIVU_LLM_BACKEND=ollama

# Ollama configuration (for local models)
ARIVU_OLLAMA_BASE_URL=http://localhost:11434
ARIVU_OLLAMA_MODEL=llama3

# OpenAI model (used when LLM_BACKEND=openai)
ARIVU_OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────
ARIVU_DATABASE_URL=sqlite+aiosqlite:///data/arivu.db

# ── Data Directory ────────────────────────────────────────────
ARIVU_DATA_DIR=data

# ── RAG Configuration ─────────────────────────────────────────
ARIVU_DEFAULT_CHUNK_SIZE=1000
ARIVU_DEFAULT_CHUNK_OVERLAP=200
ARIVU_DEFAULT_TOP_K=5

# ── Web Search (Optional) ─────────────────────────────────────
# ARIVU_TAVILY_API_KEY=

# ── Debug Mode ────────────────────────────────────────────────
ARIVU_DEBUG=false
