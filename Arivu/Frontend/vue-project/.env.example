# Arivu Frontend Configuration Example
# Copy this to .env.development or .env.production and update as needed

# ── API Configuration ─────────────────────────────────────────────
# Backend API base URL (used by axios for API calls)
# For development: http://localhost:8000
# For production: Will be dynamically set via Electron IPC
VITE_API_BASE_URL=http://localhost:8000

# ── Vite Dev Server Proxy ─────────────────────────────────────────
# Backend URL for Vite development server proxy
# This is only used during development (npm run dev)
VITE_BACKEND_URL=http://127.0.0.1:8000

# ── Notes ─────────────────────────────────────────────────────────
# - Make sure these URLs match your backend configuration (ARIVU_BACKEND_PORT)
# - In Electron builds, VITE_API_BASE_URL is overridden by electronAPI.getApiConfig()
# - The dev server can be started on a custom port: npm run dev -- --port 3000
